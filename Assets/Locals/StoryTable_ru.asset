  m_TableData:
  - m_Id: 36253114368
    m_Localized: "\u0420\u044B\u0446\u0430\u0440\u044C-\u043B\u0438\u0441 \u0421\u0438\u0440\u0438\u0443\u0441
      \u043F\u043E\u0431\u0435\u0434\u0438\u043B \u0434\u0440\u0430\u043A\u043E\u043D\u0430,
      \u043D\u043E \u043A\u043E\u0440\u043E\u043B\u0435\u0432\u0441\u0442\u0432\u043E
      \u043D\u0435 \u0437\u043D\u0430\u043B\u043E \u043F\u0440\u0430\u0432\u0434\u044B.\u0412
      \u0431\u043E\u044E \u0421\u0438\u0440\u0438\u0443\u0441 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0436\u0443\u0442\u043A\u043E \u0438\u0441\u043F\u0443\u0433\u0430\u043B\u0441\u044F.
      \u0414\u0440\u0430\u043A\u043E\u043D \u0440\u0430\u0437\u0438\u043D\u0443\u043B
      \u043F\u0430\u0441\u0442\u044C, \u0430 \u043B\u0438\u0441 \u043E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430
      \u0432\u044B\u0440\u043E\u043D\u0438\u043B \u043C\u0435\u0447. \u0415\u0433\u043E
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0445\u0432\u043E\u0441\u0442
      \u0440\u0430\u0441\u043F\u0443\u0448\u0438\u043B\u0441\u044F, \u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F
      \u0438\u0441\u043A\u0440\u0430 \u043F\u043E\u0434\u043E\u0436\u0433\u043B\u0430
      \u0440\u044B\u0436\u0438\u0439 \u043C\u0435\u0445.\u0412 \u043F\u0430\u043D\u0438\u043A\u0435
      \u0421\u0438\u0440\u0438\u0443\u0441 \u043D\u0430\u0447\u0430\u043B \u0431\u0435\u0448\u0435\u043D\u043E
      \u043D\u043E\u0441\u0438\u0442\u044C\u0441\u044F \u043F\u043E \u043F\u0435\u0449\u0435\u0440\u0435.
      \u0414\u0440\u0430\u043A\u043E\u043D \u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u0443\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0437\u0430 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u043C \u0432\u0438\u0445\u0440\u0435\u043C,
      \u0437\u0430\u0432\u044F\u0437\u0430\u043B \u0448\u0435\u044E \u0432 \u0443\u0437\u0435\u043B
      \u0438 \u0441\u043B\u043E\u043C\u0430\u043B \u0435\u0451.\u0421\u0438\u0440\u0438\u0443\u0441
      \u043F\u043E\u0442\u0443\u0448\u0438\u043B \u0445\u0432\u043E\u0441\u0442,
      \u0432\u044B\u0448\u0435\u043B \u043A \u0442\u043E\u043B\u043F\u0435 \u0438
      \u0441\u043A\u0440\u043E\u043C\u043D\u043E \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F.
      \u0425\u0438\u0442\u0440\u043E\u0441\u0442\u044C \u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E\u0441\u0442\u044C
      \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 103848517632
    m_Localized: "\u041C\u0430\u0433 \u0424\u0440\u043E\u0441\u0442 \u043E\u0431\u0440\u0430\u0442\u0438\u043B
      \u0430\u0440\u043C\u0438\u044E \u043E\u0440\u043A\u043E\u0432 \u0432 \u0431\u0435\u0433\u0441\u0442\u0432\u043E,
      \u0438 \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u044F \u043F\u0440\u043E\u0441\u043B\u0430\u0432\u0438\u043B\u0430
      \u0435\u0433\u043E \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E.
      \u041D\u043E \u0424\u0440\u043E\u0441\u0442 \u0437\u043D\u0430\u043B \u043F\u043E\u0441\u0442\u044B\u0434\u043D\u0443\u044E
      \u043F\u0440\u0430\u0432\u0434\u0443.\u041E\u043D \u043D\u0435 \u0432\u044B\u0437\u044B\u0432\u0430\u043B
      \u0431\u0443\u0440\u044E, \u0443 \u043D\u0435\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0431\u044B\u043B\u0430 \u0443\u0436\u0430\u0441\u043D\u0430\u044F \u043F\u0440\u043E\u0441\u0442\u0443\u0434\u0430.
      \u041E\u043A\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439 \u043E\u0440\u043A\u0430\u043C\u0438,
      \u043C\u0430\u0433 \u0445\u043E\u0442\u0435\u043B \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
      \u0441\u0432\u0438\u0442\u043E\u043A \u043E\u0433\u043D\u0435\u043D\u043D\u043E\u0433\u043E
      \u0448\u0430\u0440\u0430, \u043D\u043E \u0447\u0443\u0434\u043E\u0432\u0438\u0449\u043D\u043E
      \u0447\u0438\u0445\u043D\u0443\u043B.\u041C\u043E\u0449\u043D\u0430\u044F \u0432\u043E\u043B\u043D\u0430
      \u043C\u043E\u0440\u043E\u0437\u043D\u043E\u0433\u043E \u0441\u043D\u0435\u0433\u0430
      \u0432\u044B\u0440\u0432\u0430\u043B\u0430\u0441\u044C \u0438\u0437 \u043D\u043E\u0441\u0430,
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432 \u043F\u043E\u043B\u0435
      \u0431\u043E\u044F \u0432 \u043A\u0430\u0442\u043E\u043A. \u041E\u0440\u043A\u0438
      \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0438\u0441\u044C,
      \u0432\u0440\u0435\u0437\u0430\u043B\u0438\u0441\u044C \u0434\u0440\u0443\u0433
      \u0432 \u0434\u0440\u0443\u0433\u0430 \u0438 \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0441 \u0433\u043E\u0440\u044B.\u0424\u0440\u043E\u0441\u0442 \u0432\u044B\u0442\u0435\u0440
      \u043D\u043E\u0441 \u0438 \u043F\u0440\u0438\u043D\u044F\u043B \u0441\u043B\u0430\u0432\u0443.
      \u0421\u0438\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u043E\u0441\u0442\u0443\u0434\u0430
      \u2014 \u043B\u0443\u0447\u0448\u0430\u044F \u0437\u0430\u0449\u0438\u0442\u0430."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
